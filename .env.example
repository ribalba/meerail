# Copy to .env and adjust.
#
# Application settings do NOT live here any more — they are in meerail.toml, one
# file for both the server and the agent (see meerail.example.toml).
#
# What is left is the part that cannot live there: docker compose reads .env to
# expand ${...} in the compose files, and the Postgres image takes its
# credentials from the environment and nowhere else. Compose cannot read TOML,
# so these three stay.
POSTGRES_USER=meerail
POSTGRES_PASSWORD=meerail
POSTGRES_DB=meerail

# If you change POSTGRES_PASSWORD, change database.url in meerail.toml to match:
# these credentials create the database, that URL connects to it, and nothing
# reconciles them for you.


# --- overrides ----------------------------------------------------------------
# Anything else you put here overrides meerail.toml, because the precedence is
#
#   environment  >  .env  >  meerail.toml  >  built-in default
#
# which makes this the place for a value that differs per machine and should not
# be committed. It is an override layer, not a second home for configuration —
# if a setting has one value everywhere, put it in meerail.toml instead.
#
# The names are the TOML keys in upper case: database.url -> DATABASE_URL,
# server.password -> SERVER_PASSWORD, agent.store_raw_mime -> STORE_RAW_MIME.
#
# DATABASE_URL=postgresql+psycopg://meerail:meerail@localhost:5432/meerail
# SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-48
